{
  "name": "bunkengura-desktop",
  "version": "0.1.0",
  "description": "文献蔵デスクトップ版 — PDFを読みながら辞書引き・翻訳・単語帳づくりができる読書アプリ",
  "author": "hidetako",
  "license": "MIT",
  "private": true,
  "main": "./out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "pack:win": "npm run build && electron-builder --win --publish never",
    "pack:dir": "npm run build && electron-builder --dir --publish never"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "pdfjs-dist": "^4.8.69"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
